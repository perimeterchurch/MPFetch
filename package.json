{
    "name": "ministryplatform-fetch",
    "homepage": "https://github.com/perimeterchurch/MPFetch",
    "private": false,
    "version": "1.2.3",
    "description": "A library for fetching data from MinistryPlatform using the customwidget API",
    "keywords": [
        "ministryplatform",
        "customwidget",
        "fetch",
        "api"
    ],
    "license": "MIT",
    "type": "module",
    "files": [
        "./dist"
    ],
    "main": "./dist/mpfetch.umd.cjs",
    "module": "./dist/mpfetch.js",
    "types": "./dist/mpfetch.d.ts",
    "exports": {
        "types": "./dist/mpfetch.d.ts",
        "import": "./dist/mpfetch.js",
        "require": "./dist/mpfetch.umd.cjs"
    },
    "scripts": {
        "dev": "vite --port 5500",
        "check-types": "tsc --noEmit",
        "build": "vite build",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "globals": "^16.5.0",
        "prettier": "^3.5.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^6.4.5",
        "vite-plugin-dts": "^4.5.4"
    },
    "pnpm": {
        "overrides": {
            "minimatch@^9": "^11.0.4",
            "minimatch@^10": "^11.0.4"
        }
    }
}
